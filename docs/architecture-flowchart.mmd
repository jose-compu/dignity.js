flowchart TB
  subgraph Apps["Your application"]
    UI["UI / game / feed"]
    React["dignity.js/react hooks"]
  end

  subgraph DignityApps["Dignity Apps"]
    Iframe["Sandboxed iframe app"]
    Bridge["MessageChannel RPC bridge"]
    Host["DignityAppHost + CSP"]
    Manifest["Manifest & stored commands"]
  end

  subgraph Command["DignityP2P command path"]
    API["Object CRUD surface\ncreate · read · list · update · remove"]
    Repl["Operation log + replication"]
    Disc["Discovery & presence\njoinDiscovery · listPeers"]
    Gossip["PeerGroup gossip\njoinPeerGroup · fan-out"]
    Snap["Snapshots & hash chain\nlate-joiner catch-up"]
    Propose["Delegated proposals\nproposeUpdate · acceptProposal"]
    RecordHash["record.hash\nsha512 canonical payload"]
  end

  subgraph CQRS["CQRS read path"]
    Events["Signed domain events\nauto-publish on writes"]
    Replica["DignityQueryReplica\nread-only materialized view"]
    Tiers["Live / bulk tiers\n5k live cap per publisher"]
    Relay["Bulk relay election"]
  end

  subgraph Verify["Verification v0.13"]
    VReg["registerVerification\nregisterPublisherVerification"]
    VHash["Logic hash + semver policies"]
    Reflect["Reflective fingerprints\nAST-canonical function sources"]
    PubTrust["Publisher-scoped official dapp trust"]
  end

  subgraph Security["MessageSecurityService"]
    Sign["Ed25519 signing"]
    Bcast["Broadcast encryption\nPBKDF2 + shared password"]
    Direct["Direct encryption\nrecipient public key"]
    PoW["Sloth VDF proof-of-work"]
    Canon["stableStringify\ncanonical payloads"]
    Identity["Identity rotation & cold recovery"]
    Ban["Auto peer ban on bad sig/PoW"]
  end

  subgraph Network["Network adapters"]
    PeerJS["PeerJS / WebRTC"]
    WS["WebSocket signaling pool"]
    Mem["InMemoryNetwork\nlocal / tests"]
    Peers["Remote peers"]
  end

  subgraph Persist["Optional persistence"]
    IDB["IndexedDB\nreload survival"]
  end

  UI --> API
