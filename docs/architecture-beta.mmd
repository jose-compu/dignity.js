%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '28px', 'fontFamily': 'Arial, sans-serif' }, 'architecture': { 'idealEdgeLengthMultiplier': 2.2, 'nodeSeparation': 90 }}}%%
architecture-beta
    group apps(internet)[Your App]

    service ui(server)[UI App] in apps
    service hooks(server)[React Hooks] in apps

    group core(cloud)[DignityP2P Core]

    service api(server)[REST API] in core
    service repl(server)[Replication] in core
    service disc(server)[Discovery] in core
    service snap(server)[Snapshots] in core
    service hash(disk)[Content Hash] in core

    group security(cloud)[Security]

    service sign(server)[Ed25519 Sign] in security
    service enc(disk)[Encryption] in security
    service pow(server)[Sloth VDF PoW] in security
    service canon(disk)[stableStringify] in security

    group network(internet)[Network]

    service peerjs(internet)[PeerJS WebRTC] in network
    service wspool(cloud)[Signaling Pool] in network

    group persist(database)[Persistence]

    service idb(database)[IndexedDB] in persist

    service peers(internet)[Remote Peers]

    ui:B -- T:api
    hooks:B -- T:api
    api:B -- T:repl
    repl:R -- L:disc
    repl:R -- L:snap
    repl:B -- T:hash
    repl:B -- T:sign
    canon:T -- B:sign
    canon:T -- B:pow
    hash:T -- B:canon
    sign:B -- T:enc
    enc:B -- T:peerjs
    enc:B -- T:wspool
    peerjs:B -- T:peers
    wspool:B -- T:peers
    repl:B -- T:idb
    idb:T -- B:repl
