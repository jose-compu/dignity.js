{
  "name": "dignity.js",
  "version": "0.13.0",
  "description": "P2P object API for decentralized JavaScript applications",
  "homepage": "https://jose-compu.github.io/dignity.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jose-compu/dignity.js.git"
  },
  "bugs": {
    "url": "https://github.com/jose-compu/dignity.js/issues"
  },
  "main": "dist/dignity.cjs.js",
  "module": "dist/dignity.esm.js",
  "browser": "dist/dignity.esm.js",
  "unpkg": "dist/dignity.min.js",
  "jsdelivr": "dist/dignity.min.js",
  "exports": {
    ".": {
      "require": "./dist/dignity.cjs.js",
      "import": "./dist/dignity.esm.js",
      "default": "./dist/dignity.esm.js"
    },
    "./react": {
      "require": "./src/react/index.js",
      "import": "./src/react/index.js",
      "default": "./src/react/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "src",
    "docs/index.html",
    "docs/openapi-like.json",
    "docs/favicon.ico",
    "docs/assets",
    "examples"
  ],
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --runInBand",
    "test:peer-group": "jest tests/unit/peer-group-gossip.test.js tests/unit/peer-group-helpers.test.js tests/unit/domain-events.test.js tests/unit/peer-group-tiers.test.js tests/unit/query-replica.test.js tests/unit/view-consistency.test.js tests/integration/peer-group-gossip-e2e.test.js tests/integration/cqrs-tiered-peergroup.test.js --runInBand --coverage=false",
    "test:stress-peer-group": "RUN_STRESS_TESTS=1 jest tests/stress/peer-group-scale.test.js --runInBand --coverage=false",
    "stress:peer-group": "node scripts/stress-peer-group.js",
    "test:cloudflare-live": "RUN_CLOUDFLARE_LIVE_TESTS=1 jest tests/integration/cloudflare-signaling-live.test.js --runInBand",
    "test:e2e": "RUN_BROWSER_E2E=1 playwright test",
    "test:e2e:browser": "RUN_BROWSER_E2E=1 playwright test tests/e2e/dignity-apps-browser.spec.js tests/e2e/playground-browser.spec.js",
    "test:e2e:chess": "RUN_CHESS_E2E=1 playwright test tests/e2e/chess-resume.spec.js",
    "test:pow-calibrate": "RUN_POW_CALIBRATE=1 jest tests/unit/sloth-vdf-timing.test.js --runInBand --coverage=false",
    "build": "node scripts/build.js",
    "build:chess": "node scripts/build-chess-demo.js",
    "build:tictactoe": "node scripts/build-tictactoe-demo.js",
    "docs:favicon": "node scripts/generate-favicon.js",
    "docs:build": "npm run build:chess && npm run build:tictactoe",
    "docs:dev": "node scripts/serve-docs.js",
    "docs:serve": "node scripts/serve-docs.js",
    "docs:stop": "node scripts/stop-docs.js",
    "docs:api-reference": "node scripts/generate-api-reference.js",
    "benchmark": "node scripts/run-benchmarks.js --write docs/benchmarks/results.json",
    "benchmark:quick": "node scripts/run-benchmarks.js --quick",
    "docs:check": "node -e \"const fs=require('fs');['docs/index.html','docs/favicon.ico','docs/api-reference.md','docs/browser-compatibility.md','docs/benchmarks/results.json','docs/playground/index.html','docs/assets/playground.js','docs/assets/playground-demos.js','docs/assets/playground.css','docs/chess/index.html','docs/chess/favicon.ico','docs/assets/favicon.svg','docs/chess/assets/chess-app.js','docs/tictactoe/index.html','docs/tictactoe/favicon.ico','docs/tictactoe/assets/tictactoe-app.js','docs/apps/index.html','docs/apps/registry.json','docs/apps/timeline/index.html','docs/assets/dignity-logo.png','docs/assets/dignity.esm.js','docs/assets/highlight/highlight.min.js','docs/assets/highlight/github.min.css','docs/assets/highlight/github-dark.min.css'].forEach(p=>fs.accessSync(p));\"",
    "example:tictactoe": "node examples/decentralized-tictactoe.js",
    "example:chess": "node examples/decentralized-chess-lite.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "decentralized",
    "rest",
    "objects"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.0",
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "astring": "^1.9.0",
    "peerjs": "^1.5.5",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
